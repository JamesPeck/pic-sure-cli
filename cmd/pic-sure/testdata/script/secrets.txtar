# secrets rotate's refusals, before it changes anything, and a rotation
# of a secret only the services read. The database rotations are covered
# by the ops tests and the real runs.

# Unknown secrets and misplaced flags are usage errors.
exitcode 2 pic-sure --stack stack secrets rotate nope
stderr 'unknown secret "nope"; secrets rotate takes db-root, db-picsure, db-auth, db-airflow, dictionary-db, introspection-token, query-service-token, application-token, logging-key, obfuscation-salt, hpds-key, auth0-client-secret'
exitcode 2 pic-sure --stack stack secrets rotate logging-key --discard-data --yes
stderr '--discard-data is only for hpds-key'
exitcode 4 pic-sure --stack stack secrets rotate hpds-key --discard-data
stderr '--discard-data deletes the loaded HPDS data; pass --yes with it'

# Without a terminal to confirm on, --yes is needed.
cp stack/.pic-sure/secrets.yaml secrets-before.yaml
exitcode 4 pic-sure --stack stack secrets rotate logging-key
stderr 'needs confirmation: pass --yes'

# A secret read from stdin needs --yes, since stdin can't also answer.
stdin client-secret.txt
exitcode 4 pic-sure --stack stack secrets rotate auth0-client-secret
stderr 'reads the new value from stdin, so it needs --yes'

# PSAMA can't sign with a client secret under 32 bytes.
stdin short-secret.txt
exitcode 2 pic-sure --stack stack secrets rotate auth0-client-secret --yes
stderr 'must be at least 32 bytes'
cmp stack/.pic-sure/secrets.yaml secrets-before.yaml
! exists docker.log

# A stack init hasn't finished, or that was never rendered, is exit 3.
exitcode 3 pic-sure --stack partial secrets rotate logging-key --yes
stderr 'isn''t initialised; run `pic-sure init .*partial` to finish it'
exitcode 3 pic-sure --stack unrendered secrets rotate logging-key --yes
stderr 'run `pic-sure up`'

# logging-key is generated, saved, and the running services that use it
# are recreated.
cp rotate.scenario docker.scenario
exec pic-sure --stack stack secrets rotate logging-key --yes
stdout '^Rotated logging-key for stack demo.$'
stdout '^Restarted gateway.$'
! exec grep 'logging_api_key: oldloggingkey' stack/.pic-sure/secrets.yaml
exec grep -E 'logging_api_key: [0-9a-f]{64}$' stack/.pic-sure/secrets.yaml
exec grep 'up -d --wait --wait-timeout 900 gateway$' docker.log
! exec grep oldloggingkey docker.log

-- client-secret.txt --
synthetic-auth0-client-secret-0123456789abcdef
-- short-secret.txt --
too-short
-- rotate.scenario --
docker compose * config --no-interpolate => 0 stdout=compose-config.yaml
docker compose * ps --all --format json => 0 stdout=ps.json
docker compose * up -d --wait * => 0
-- compose-config.yaml --
services:
  gateway:
    environment:
      LOGGING_API_KEY: ${LOGGING_API_KEY}
  dictionary-api:
    environment:
      LOGGING_API_KEY: ${LOGGING_API_KEY}
  psama:
    environment:
      OTHER: x
-- ps.json --
{"ID":"1","Service":"gateway","State":"running","Health":"healthy"}
{"ID":"2","Service":"psama","State":"running","Health":"healthy"}
{"ID":"3","Service":"dictionary-api","State":"exited","Health":""}
-- stack/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- stack/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
-- stack/.pic-sure/secrets.yaml --
db_root_password: rootpw
logging_api_key: oldloggingkey
auth0_client_secret: synthetic-client-secret-0123456789abcdef
auth0_client_secret_generated: true
-- stack/.pic-sure/render/compose.yaml --
services: {}
-- partial/pic-sure.yaml --
schema: 1
name: partial
auth: {mode: open, admin_email: admin@example.com}
-- partial/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- unrendered/pic-sure.yaml --
schema: 1
name: unrendered
auth: {mode: open, admin_email: admin@example.com}
-- unrendered/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
-- unrendered/.pic-sure/secrets.yaml --
db_root_password: rootpw
