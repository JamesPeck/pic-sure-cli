# up's refusals, before it changes anything. The converge itself is
# covered by the ops tests and the real runs.
env XDG_CACHE_HOME=$WORK/cache

# No stack here or above: exit 3.
exitcode 3 pic-sure up
stderr 'no pic-sure stack found'

# A --skip-step up doesn't have is exit 2, listing the ones it has.
exitcode 2 pic-sure --stack stack up --skip-step resolve
stderr '--skip-step resolve: up has no such step; it can skip images, tls, truststore, render, db, migrate, seed, hpds-key, start, restart$'
! exists docker.log

# A stack init hasn't finished is exit 3, pointing at init.
exitcode 3 pic-sure --stack partial up
stderr 'isn''t initialised; run `pic-sure init .*partial` to finish it'
exitcode 3 pic-sure --stack nosecrets up
stderr 'has no .pic-sure/secrets.yaml; run `pic-sure init .*nosecrets` to finish it'

# A stack that left open mode can't keep the client secret generated for
# it: up points at secrets rotate, and changes nothing.
cp left-open/.pic-sure/secrets.yaml secrets-before.yaml
exitcode 3 pic-sure --stack left-open up
stderr 'auth.mode is required, but the stack''s Auth0 client secret is a random one made for open mode; pipe the Auth0 application''s client secret to `pic-sure secrets rotate auth0-client-secret`'
cmp left-open/.pic-sure/secrets.yaml secrets-before.yaml
! exists docker.log

# Outside open mode, a missing client secret gets the same advice.
exitcode 3 pic-sure --stack no-client-secret up
stderr 'the stack has no Auth0 client secret; pipe'

-- stack/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- stack/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
-- partial/pic-sure.yaml --
schema: 1
name: partial
auth: {mode: open, admin_email: admin@example.com}
-- partial/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- nosecrets/pic-sure.yaml --
schema: 1
name: nosecrets
auth: {mode: open, admin_email: admin@example.com}
-- nosecrets/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
-- left-open/pic-sure.yaml --
schema: 1
name: left-open
auth: {mode: required, admin_email: admin@example.com, auth0: {tenant: example, client_id: abc}}
-- left-open/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
-- left-open/.pic-sure/secrets.yaml --
db_root_password: rootpw
auth0_client_secret: generated-0123456789abcdef0123456789abcdef
auth0_client_secret_generated: true
-- no-client-secret/pic-sure.yaml --
schema: 1
name: no-client-secret
auth: {mode: explore, admin_email: admin@example.com, auth0: {tenant: example, client_id: abc}}
-- no-client-secret/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
-- no-client-secret/.pic-sure/secrets.yaml --
db_root_password: rootpw
