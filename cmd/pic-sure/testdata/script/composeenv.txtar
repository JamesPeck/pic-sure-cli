-- leaky/pic-sure.yaml --
schema: 1
name: leaky
auth: {mode: open, admin_email: admin@example.com}
-- leaky/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- leaky/.pic-sure/secrets.yaml --
db_root_password: rootpw-0123456789
-- leaky/.pic-sure/render/compose.yaml --
