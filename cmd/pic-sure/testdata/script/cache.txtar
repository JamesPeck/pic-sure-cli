env XDG_CACHE_HOME=$WORK/cache

# list: the commit-tagged hpds image is kept for the stack whose directory
# is gone, the zed dev image is unused, and the stack shows as unreadable.
exec pic-sure cache list
stdout '^Cache: .*/cache/pic-sure$'
stdout '^  gone +/nonexistent/moved-stack +UNREADABLE: '
stdout '^image +hms-dbmi/pic-sure-hpds:0123456789ab +425 MB +unknown-stack +maybe gone$'
stdout '^image +hms-dbmi/pic-sure-psama:dev-zed-0123456789ab +1.20 kB +unused +-$'
stdout '^download +downloads/nhanes.tgz +7 B +recent +-$'
stdout '^  deleted +/nonexistent/deleted-stack +GONE: '
! stdout 'other-tool'

exec pic-sure cache list --json
stdout '^\{"schema_version":2,'
stdout '"name":"hms-dbmi/pic-sure-hpds:0123456789ab","image_id":"sha256:hpds","size":424693812,"status":"unknown-stack","may_be_used_by":\["gone"\]'

# --dry-run removes nothing.
exec pic-sure --plain cache prune --dry-run
stdout '^would remove image hms-dbmi/pic-sure-psama:dev-zed-0123456789ab \(1.20 kB\)$'
stdout '^Would remove 1 item, freeing 1.20 kB. Kept 1 unknown-stack, 1 recent.$'
stdout '^would forget the gone stack deleted \(/nonexistent/deleted-stack\)$'
stderr 'can''t read the state of gone at /nonexistent/moved-stack .*--force removes them'
! stderr 'deleted-stack .*--force'
exists cache/pic-sure/stacks/deleted
! grep 'image rm' docker.log
exists cache/pic-sure/downloads/nhanes.tgz

# prune removes only the unused image, and forgets the gone stack.
exec pic-sure --plain cache prune
stdout '^forgot the gone stack deleted'
! exists cache/pic-sure/stacks/deleted
grep '^docker image rm hms-dbmi/pic-sure-psama:dev-zed-0123456789ab$' docker.log
! grep 'image rm hms-dbmi/pic-sure-hpds' docker.log
exists cache/pic-sure/downloads/nhanes.tgz
exists cache/pic-sure/locks

# --force also removes what the unreadable stack might use, but never the
# recent download or the lock files.
exec pic-sure --json cache prune --force
grep '^docker image rm hms-dbmi/pic-sure-hpds:0123456789ab$' docker.log
exists cache/pic-sure/downloads/nhanes.tgz
exists cache/pic-sure/locks
stdout '"type":"result","ok":true'

-- cache/pic-sure/stacks/deleted --
{"dir":"/nonexistent/deleted-stack","name":"deleted"}
-- cache/pic-sure/downloads/nhanes.tgz --
nhanes
-- docker.scenario --
docker ps -a -q --no-trunc => 0 stdout=ps.txt
docker container inspect id-gone => 0 stdout=containers.json
docker volume ls -q --filter label=org.hms-dbmi.picsure.stack-dir => 0
docker network ls -q --no-trunc --filter label=org.hms-dbmi.picsure.stack-dir => 0
docker image ls --filter reference=hms-dbmi/* * => 0 stdout=images.txt
docker image inspect * => 0 stdout=images.json
docker image rm * => 0
-- ps.txt --
id-gone
-- containers.json --
[{"Id":"id-gone","Name":"/gone-hpds-1","Image":"sha256:alpine","Config":{"Image":"alpine:3","Labels":{"org.hms-dbmi.picsure.stack":"gone","org.hms-dbmi.picsure.stack-dir":"/nonexistent/moved-stack"}},"State":{"Status":"exited"}}]
-- images.txt --
hms-dbmi/pic-sure-hpds:0123456789ab
hms-dbmi/pic-sure-hpds:other-tool
hms-dbmi/pic-sure-psama:dev-zed-0123456789ab
-- images.json --
[{"Id":"sha256:hpds","RepoTags":["hms-dbmi/pic-sure-hpds:0123456789ab","hms-dbmi/pic-sure-hpds:other-tool"],"Size":424693812,"Created":"2026-01-01T00:00:00Z"},
{"Id":"sha256:hpds","RepoTags":["hms-dbmi/pic-sure-hpds:0123456789ab","hms-dbmi/pic-sure-hpds:other-tool"],"Size":424693812,"Created":"2026-01-01T00:00:00Z"},
{"Id":"sha256:zed","RepoTags":["hms-dbmi/pic-sure-psama:dev-zed-0123456789ab"],"Size":1200,"Created":"2026-01-01T00:00:00Z"}]
