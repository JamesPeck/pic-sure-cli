# Every verb needs a stack: exit 3.
exitcode 3 pic-sure down
stderr 'no pic-sure stack found'
exitcode 3 pic-sure ps
exitcode 3 pic-sure compose -- ps

# A stack that hasn't been rendered: exit 3, pointing at up, before docker
# is called.
exitcode 3 pic-sure --stack unrendered down
stderr '^pic-sure: the stack hasn''t been rendered yet; run `pic-sure up`$'
exitcode 3 pic-sure --stack unrendered restart hpds
exitcode 3 pic-sure --stack unrendered ps
exitcode 3 pic-sure --stack unrendered logs
exitcode 3 pic-sure --stack unrendered compose -- ps
exitcode 3 pic-sure --stack unrendered --json ps
stdout '"exit_code":3'
! exists docker.log

cd stack

# down: compose down with the stack's files, its output as step logs.
exec pic-sure --plain down
stderr 'Stop the stack'
stderr '\|  Container demo-hpds-1  Removed'
! stdout .
grep '^docker compose -f .*/stack/.pic-sure/render/compose.yaml -f .*/stack/overrides/10-local.yaml --project-directory .*/stack --env-file /dev/null --progress plain down --remove-orphans$' $WORK/docker.log

# --json: compose's progress as JSON, relayed as log events, then the result.
exec pic-sure --json down
stdout '"type":"step_started","id":"down"'
stdout '"type":"log","id":"down","stream":"stderr","line":"\{\\"id\\":\\"Container demo-hpds-1\\"'
stdout '"type":"step_done","id":"down","status":"ok"'
stdout '^\{"type":"result","ok":true\}$'
grep '--progress json down --remove-orphans$' $WORK/docker.log

# A compose failure is exit 1 with compose's message, and a failed step.
exitcode 1 pic-sure --json restart nosuch
stderr 'no such service: nosuch'
stdout '"type":"step_done","id":"restart","status":"failed"'
stdout '"ok":false,"error":\{"exit_code":1,.*"step":"restart"\}'

# restart: all services, or the ones named.
exec pic-sure --plain restart
stderr 'Restart every service'
grep '--progress plain restart$' $WORK/docker.log
exec pic-sure --plain restart hpds psama
stderr 'Restart hpds, psama'
grep '--progress plain restart hpds psama$' $WORK/docker.log

# down, restart and compose are gated as mutating: a newer stack is exit 5.
exitcode 5 pic-sure --stack $WORK/newer down
exitcode 5 pic-sure --stack $WORK/newer restart
exitcode 5 pic-sure --stack $WORK/newer compose -- ps

# ps and logs are read-only: they run on a newer stack, with a warning,
# though this CLI can't read its config.
exec pic-sure --stack $WORK/newer ps
stderr 'warning: '
stdout '^hpds +running'
exec pic-sure --stack $WORK/newer logs hpds
stdout '^hpds-1  \| started$'

# ps: a table, or one report with --json.
exec pic-sure ps
stdout '^SERVICE +STATE +HEALTH +STATUS$'
stdout '^hpds +running +healthy +Up 2 minutes \(healthy\)$'
stdout '^psama +exited +- +Exited \(1\) 1 minute ago$'
exec pic-sure --json ps
stdout '^\{"schema_version":2,"services":\[\{"service":"hpds","container":"demo-hpds-1","state":"running","health":"healthy","status":"Up 2 minutes \(healthy\)","exit_code":0\},\{"service":"psama",'
! stdout '"type"'
grep '--env-file /dev/null ps --all --format json$' $WORK/docker.log

# logs: the logs on stdout and compose's own messages on stderr, or log
# events of step logs with --json.
exec pic-sure logs hpds
stdout '^hpds-1  \| started$'
! stderr .
grep '--env-file /dev/null logs hpds$' $WORK/docker.log
exitcode 1 pic-sure logs nosuch
! stdout .
stderr '^no such service: nosuch$'
exec pic-sure --json logs -f
stdout '"type":"step_started","id":"logs"'
stdout '"type":"log","id":"logs","stream":"stdout","line":"hpds-1  \| started"'
stdout '"type":"step_done","id":"logs","status":"ok"'
stdout '"type":"result","ok":true'
grep '--env-file /dev/null logs --follow$' $WORK/docker.log

# compose: passthrough with the stack's files and env; compose's exit code.
exec pic-sure compose -- ps -a
stdout 'raw compose ps'
grep '--env-file /dev/null ps -a$' $WORK/docker.log
exitcode 4 pic-sure compose -- top
grep '--env-file /dev/null top$' $WORK/docker.log
exitcode 2 pic-sure compose ps
stderr 'put -- and then the docker compose arguments'
exitcode 2 pic-sure compose --
exitcode 2 pic-sure compose
exitcode 2 pic-sure --json compose -- ps
stdout '"exit_code":2'

# Ctrl-C ends logs -f: the follow is cancelled and its docker child killed.
cd $WORK
chmod 755 bin/docker
env PATH=$WORK/bin${:}$PATH
! exec pic-sure --stack stack logs -f &logs&
exec sh -c 'while [ ! -f follow.pid ]; do sleep 0.05; done'
kill -INT logs
wait logs
stderr '^pic-sure: interrupted \(interrupt\)$'
! stderr 'docker compose'
exec sh -c '! kill -0 "$(cat follow.pid)" 2>/dev/null'

-- docker.scenario --
docker compose * --progress plain down --remove-orphans => 0 stderr=down.txt
docker compose * --progress json down --remove-orphans => 0 stderr=down.json
docker compose * restart nosuch => 1 stderr=nosuch.json
docker compose * --progress plain restart* => 0
docker compose * ps --all --format json => 0 stdout=ps.json
docker compose * logs nosuch => 1 stderr=nosuch.txt
docker compose * logs* => 0 stdout=logs.txt
docker compose * ps -a => 0 stdout=raw.txt
docker compose * top => 4
-- down.txt --
 Container demo-hpds-1  Removed
-- down.json --
{"id":"Container demo-hpds-1","status":"Removed"}
-- nosuch.json --
{"error":true,"message":"no such service: nosuch"}
-- nosuch.txt --
no such service: nosuch
-- ps.json --
{"ID":"aaa","Name":"demo-hpds-1","Project":"demo","Service":"hpds","State":"running","Status":"Up 2 minutes (healthy)","Health":"healthy","ExitCode":0}
{"ID":"bbb","Name":"demo-psama-1","Project":"demo","Service":"psama","State":"exited","Status":"Exited (1) 1 minute ago","Health":"","ExitCode":1}
-- logs.txt --
hpds-1  | started
-- raw.txt --
raw compose ps
-- bin/docker --
#!/bin/sh
echo $$ > "$HOME/follow.pid"
exec sleep 30
-- stack/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- stack/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- stack/.pic-sure/secrets.yaml --
db_root_password: rootpw
-- stack/.pic-sure/render/compose.yaml --
services: {}
-- stack/overrides/10-local.yaml --
services: {}
-- unrendered/pic-sure.yaml --
schema: 1
name: unrendered
auth: {mode: open, admin_email: admin@example.com}
-- unrendered/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- newer/pic-sure.yaml --
schema: 2
name: newer
auth: {mode: open, admin_email: admin@example.com}
-- newer/.pic-sure/state.json --
{"cli_version": "v9.0.0", "schema_version": 2}
-- newer/.pic-sure/render/compose.yaml --
services: {}
