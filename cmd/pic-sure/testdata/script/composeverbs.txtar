# Every verb needs a stack: exit 3.
exitcode 3 pic-sure down
stderr 'no pic-sure stack found'
exitcode 3 pic-sure ps
exitcode 3 pic-sure compose -- ps

# A stack that hasn't been rendered: exit 3, pointing at up, before docker
# is called.
exitcode 3 pic-sure --stack unrendered down
stderr '^pic-sure: the stack has not been rendered yet; run `pic-sure up`$'
exitcode 3 pic-sure --stack unrendered restart hpds
exitcode 3 pic-sure --stack unrendered ps
exitcode 3 pic-sure --stack unrendered logs
exitcode 3 pic-sure --stack unrendered compose -- ps
exitcode 3 pic-sure --stack nosecrets down
stderr 'no secrets.yaml; run `pic-sure init`'
exitcode 3 pic-sure --stack nosecrets compose -- up -d
exitcode 3 pic-sure --stack unrendered --json ps
stdout '"exit_code":3'
! exists docker.log

cd stack

# down: compose down with the stack's files, its output as step logs,
# after looking for helper containers a killed command left.
exec pic-sure --plain down
stderr 'Stop the stack'
stderr '\|  Container demo-hpds-1  Removed'
! stdout .
grep '^docker ps --all --no-trunc --filter label=org.hms-dbmi.picsure.stack=demo --format ' $WORK/docker.log
grep '^docker compose -f .*/stack/.pic-sure/render/compose.yaml -f .*/stack/overrides/10-local.yaml --project-directory .*/stack --env-file /dev/null -p demo --progress plain down --remove-orphans$' $WORK/docker.log

# --json: compose's progress as JSON, relayed as log events, then the result.
exec pic-sure --json down
stdout '"type":"step_started","id":"down"'
stdout '"type":"log","id":"down","stream":"stderr","line":"\{\\"id\\":\\"Container demo-hpds-1\\"'
stdout '"type":"step_done","id":"down","status":"ok"'
stdout '^\{"type":"result","ok":true\}$'
grep '--progress json down --remove-orphans$' $WORK/docker.log

# A helper container a killed command left that can't be removed doesn't
# stop compose down; the command still fails, naming it.
exec sh -c 'sed "s|@DIR@|$(pwd -P)|g" $WORK/helpers.tmpl >$WORK/helpers.json'
exec sh -c 'cat $WORK/helperfail.scenario $WORK/docker.scenario >$WORK/s && mv $WORK/s $WORK/docker.scenario'
rm $WORK/docker.log
exitcode 1 pic-sure --plain down
stderr 'couldn''t remove container demo-dictionaryetl-0a1b2c3d, which an earlier run left'
stderr 'couldn''t remove containers demo-dictionaryetl-0a1b2c3d'
grep '^docker rm -v -f demo-dictionaryetl-0a1b2c3d$' $WORK/docker.log
grep 'down --remove-orphans$' $WORK/docker.log

# A compose failure is exit 1 with compose's message, and a failed step.
exitcode 1 pic-sure --json restart nosuch
stderr 'no such service: nosuch'
stdout '"type":"step_done","id":"restart","status":"failed"'
stdout '"ok":false,"error":\{"exit_code":1,.*"step":"restart"\}'

# restart: all services, or the ones named.
exec pic-sure --plain restart
stderr 'Restart every service'
grep '--progress plain restart$' $WORK/docker.log
exec pic-sure --plain restart hpds psama
stderr 'Restart hpds, psama'
grep '--progress plain restart hpds psama$' $WORK/docker.log

# down, restart and compose's mutating subcommands are gated as mutating:
# a newer stack is exit 5.
exitcode 5 pic-sure --stack $WORK/newer down
exitcode 5 pic-sure --stack $WORK/newer restart
exitcode 5 pic-sure --stack $WORK/newer compose -- up -d
exitcode 5 pic-sure --stack $WORK/newer compose -- --profile x nosuch

# compose runs on the stack's own project only.
exitcode 2 pic-sure --stack $WORK/newer compose -- -p other down
stderr 'compose -- -p: pic-sure runs compose on the stack''s own project; use --stack DIR for another stack'

# compose's read-only subcommands run on a newer stack, with a warning.
exec pic-sure --stack $WORK/newer compose -- -f x.yaml ps -a
stderr 'warning: '
stdout 'raw compose ps'

# ps and logs are read-only: they run on a newer stack, with a warning,
# though this CLI can't read its config.
exec pic-sure --stack $WORK/newer ps
stderr 'warning: '
stdout '^hpds +running'
exec pic-sure --stack $WORK/newer logs hpds
stdout '^hpds-1  \| started$'

# ps: a table, or one report with --json.
exec pic-sure ps
stdout '^SERVICE +STATE +HEALTH +STATUS$'
stdout '^hpds +running +healthy +Up 2 minutes \(healthy\)$'
stdout '^psama +exited +- +Exited \(1\) 1 minute ago$'
exec pic-sure --json ps
stdout '^\{"schema_version":2,"services":\[\{"service":"hpds","container":"demo-hpds-1","state":"running","health":"healthy","status":"Up 2 minutes \(healthy\)","exit_code":0\},\{"service":"psama",'
! stdout '"type"'
grep '--env-file /dev/null -p demo ps --all --format json$' $WORK/docker.log

# logs: the logs on stdout and compose's own messages on stderr, or log
# events of step logs with --json.
exec pic-sure logs hpds
stdout '^hpds-1  \| started$'
! stderr .
grep '--env-file /dev/null -p demo logs hpds$' $WORK/docker.log
exitcode 1 pic-sure logs nosuch
! stdout .
stderr '^no such service: nosuch$'
exec pic-sure --json logs -f
stdout '"type":"step_started","id":"logs"'
stdout '"type":"log","id":"logs","stream":"stdout","line":"hpds-1  \| started"'
stdout '"type":"step_done","id":"logs","status":"ok"'
stdout '"type":"result","ok":true'
grep '--env-file /dev/null -p demo logs --follow$' $WORK/docker.log

# compose: passthrough with the stack's files and env, pinned to the
# stack's project; compose's exit code.
exec pic-sure compose -- ps -a
stdout 'raw compose ps'
grep '--env-file /dev/null -p demo ps -a$' $WORK/docker.log
exitcode 4 pic-sure compose -- top
grep '--env-file /dev/null -p demo top$' $WORK/docker.log
exitcode 2 pic-sure compose ps
stderr 'put -- and then the docker compose arguments'
exitcode 2 pic-sure compose --
exitcode 2 pic-sure compose
exitcode 2 pic-sure --json compose -- ps
stdout '"exit_code":2'

# Ctrl-C ends logs -f: the follow is cancelled and its docker child killed.
cd $WORK
chmod 755 bin/docker
env PATH=$WORK/bin${:}$PATH
! exec pic-sure --stack stack logs -f &logs&
exec sh -c 'while [ ! -f follow.pid ]; do sleep 0.05; done'
kill -INT logs
wait logs
stderr '^pic-sure: interrupted \(interrupt\)$'
! stderr 'docker compose'
exec sh -c '! kill -0 "$(cat follow.pid)" 2>/dev/null'

# The passthrough runs compose in pic-sure's process group, where a
# terminal's Ctrl-C reaches both. A kill -INT to pic-sure alone, with no
# terminal, is forwarded, so compose stops too.
rm follow.pid
! exec pic-sure --stack stack compose -- logs -f &passlogs&
exec sh -c 'while [ ! -f follow.pid ]; do sleep 0.05; done'
kill -INT passlogs
exec sh -c 'i=0; while kill -0 "$(cat follow.pid)" 2>/dev/null; do i=$((i+1)); [ $i -lt 100 ] || exit 1; sleep 0.05; done'
wait passlogs
stderr '^pic-sure: interrupted \(interrupt\)$'

# A mutating compose subcommand holds the stack lock while compose runs,
# and a SIGTERM to pic-sure alone reaches compose, which the terminal's
# Ctrl-C would not.
rm follow.pid
! exec pic-sure --stack stack compose -- up &pass&
exec sh -c 'while [ ! -f follow.pid ]; do sleep 0.05; done'
exitcode 1 pic-sure --stack stack down
stderr 'pic-sure compose'
stderr 'pass --wait-lock'
exitcode 1 pic-sure --stack stack compose -- up -d
stderr 'pass --wait-lock'
exitcode 1 pic-sure --stack stack compose -- --dry-run wait --down-project hpds
stderr 'pass --wait-lock'

# Its read-only subcommands, like logs, take no lock, so they run.
exec pic-sure --stack stack compose -- ps -a
stdout 'raw compose ps'
exec pic-sure --stack stack compose -- logs hpds
stdout '^hpds-1  \| started$'
exec pic-sure --stack stack logs hpds

# With --wait-lock, a mutating one waits for the holder, then runs.
exec sh -c '(pic-sure --stack stack --wait-lock compose -- up -d; echo $? >wait.code) </dev/null >/dev/null 2>wait.err &'
exec sh -c 'i=0; until grep -q "waiting for" wait.err; do i=$((i+1)); [ $i -lt 200 ] || exit 1; sleep 0.05; done'
exec sh -c 'kill -TERM "$(cat parent.pid)"'
wait pass
stderr '^pic-sure: interrupted \(terminated\)$'
exec sh -c '! kill -0 "$(cat follow.pid)" 2>/dev/null'
exec sh -c 'i=0; until [ -s wait.code ]; do i=$((i+1)); [ $i -lt 200 ] || exit 1; sleep 0.05; done'
grep '^0$' wait.code
grep 'up -d$' docker.log

# The passthrough's output, and the logs that logs streams, reach the
# terminal only, never the run log, which has only the passthrough's
# subcommand and how many arguments follow it. (A failed command's error, such as
# restart's above, carries compose's last lines there, redacted.) Like ps,
# a read-only compose writes a run log only at debug level.
rm stack/.pic-sure/logs
exec pic-sure --stack stack compose -- ps -a
! exists stack/.pic-sure/logs
exec pic-sure --log-level debug --stack stack compose -- logs hpds
stdout started
! exec pic-sure --log-level debug --stack stack compose -- logs nosuch
stderr 'no such service'
exec pic-sure --log-level debug --stack stack logs hpds
stdout started
exec sh -c 'grep -rq "compose.* logs (1 more arguments)" stack/.pic-sure/logs'
exec sh -c '! grep -rq nosuch stack/.pic-sure/logs'
exec sh -c '! grep -rE "started|no such service" stack/.pic-sure/logs'

-- helperfail.scenario --
docker ps --all --no-trunc --filter label=org.hms-dbmi.picsure.stack=demo --format * => 0 stdout=helpers.json times=1
docker rm -v -f demo-dictionaryetl-0a1b2c3d => 1 stderr=rmfail.txt times=1
-- rmfail.txt --
Error response from daemon: removal of container demo-dictionaryetl-0a1b2c3d is already in progress
-- helpers.tmpl --
{"Names":"demo-dictionaryetl-0a1b2c3d","Ports":"","Labels":{"org.hms-dbmi.picsure.stack":"demo","org.hms-dbmi.picsure.stack-dir":"@DIR@","org.hms-dbmi.picsure.stack-id":"","com.docker.compose.project":""}}
-- docker.scenario --
docker compose * --progress plain down --remove-orphans => 0 stderr=down.txt
docker compose * --progress json down --remove-orphans => 0 stderr=down.json
docker compose * restart nosuch => 1 stderr=nosuch.json
docker compose * --progress plain restart* => 0
docker compose * ps --all --format json => 0 stdout=ps.json
docker compose * logs nosuch => 1 stderr=nosuch.txt
docker compose * logs* => 0 stdout=logs.txt
docker compose * ps -a => 0 stdout=raw.txt
docker compose * top => 4
docker compose * up -d => 0
docker compose * config --no-interpolate => 0
docker ps --all --no-trunc --filter label=com.docker.compose.project=* --format * => 0
docker ps --all --no-trunc --filter label=org.hms-dbmi.picsure.stack=* --format * => 0
docker volume ls -q --filter label=com.docker.compose.project=* => 0
docker volume ls -q --filter label=org.hms-dbmi.picsure.stack=* => 0
docker network ls -q --no-trunc --filter label=com.docker.compose.project=* => 0
-- down.txt --
 Container demo-hpds-1  Removed
-- down.json --
{"id":"Container demo-hpds-1","status":"Removed"}
-- nosuch.json --
{"error":true,"message":"no such service: nosuch"}
-- nosuch.txt --
no such service: nosuch
-- ps.json --
{"ID":"aaa","Name":"demo-hpds-1","Project":"demo","Service":"hpds","State":"running","Status":"Up 2 minutes (healthy)","Health":"healthy","ExitCode":0}
{"ID":"bbb","Name":"demo-psama-1","Project":"demo","Service":"psama","State":"exited","Status":"Exited (1) 1 minute ago","Health":"","ExitCode":1}
-- logs.txt --
hpds-1  | started
-- raw.txt --
raw compose ps
-- bin/docker --
#!/bin/sh
# Blocks on compose's up, logs --follow and logs -f; hands the rest to the fake.
case "$*" in
*" up" | *" logs --follow" | *" logs -f")
	echo $PPID > "$HOME/parent.pid"
	echo $$ > "$HOME/follow.pid"
	exec sleep 30
	;;
esac
PATH=${PATH#*:} exec docker "$@"
-- stack/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- stack/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- stack/.pic-sure/secrets.yaml --
db_root_password: rootpw
-- stack/.pic-sure/render/compose.yaml --
name: demo
services: {}
-- stack/overrides/10-local.yaml --
services: {}
-- unrendered/pic-sure.yaml --
schema: 1
name: unrendered
auth: {mode: open, admin_email: admin@example.com}
-- unrendered/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- unrendered/.pic-sure/secrets.yaml --
db_root_password: rootpw
-- nosecrets/pic-sure.yaml --
schema: 1
name: nosecrets
auth: {mode: open, admin_email: admin@example.com}
-- nosecrets/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- nosecrets/.pic-sure/render/compose.yaml --
name: nosecrets
services: {}
-- newer/pic-sure.yaml --
schema: 2
name: newer
auth: {mode: open, admin_email: admin@example.com}
-- newer/.pic-sure/state.json --
{"cli_version": "v9.0.0", "schema_version": 2}
-- newer/.pic-sure/render/compose.yaml --
name: newer
services: {}
