# init's usage and precondition paths, through the fake docker and git.
# The cache root must be outside TMPDIR (see doctor.txtar).
env XDG_CACHE_HOME=/nonexistent-pic-sure-init/cache

# Missing required fields are exit 2, naming every flag, before docker is
# asked anything.
exitcode 2 pic-sure init new
stderr '--admin-email: required'
stderr '--auth0-client-id: required when auth.mode is not open'
stderr '--name: required'
! exists new
! exists docker.log
exitcode 2 pic-sure --json init new --name demo
stdout '"exit_code":2'
stdout 'admin-email: required'

# Outside open mode the client secret must come on stdin.
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth0-client-id abc
stderr '^pic-sure: --auth0-client-secret-stdin is required when auth.mode is not open$'

# Bad values name their flag.
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode closed
stderr '--auth-mode'
exitcode 2 pic-sure init new --name Demo! --admin-email admin@example.com --auth-mode open
stderr '--name'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --hpds-data shared
stderr '--hpds-data shared: want local or shared:NAME'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --hpds-data shared:demo-set
stderr 'init doesn''t support shared HPDS data yet'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --source hpds=../x
stderr '--source hpds=../x: want COMPONENT=PATH'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --http-port eighty
stderr '--http-port'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --db-mode remote --db-host db.example.com
stderr '^pic-sure: --db-root-password-stdin is required when db.mode is remote$'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --skip-step bogus
stderr '--skip-step bogus: init has no such step'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --skip-step db-bootstrap
stderr '--skip-step db-bootstrap: init has no such step'

# The admin email is personal data: the debug log of the flags redacts it.
exitcode 2 pic-sure --log-level debug init new --name demo --admin-email admin@example.com --auth-mode open --skip-step bogus
stderr 'flags="\[--admin-email=\[REDACTED\] '
! stderr 'admin@example.com'
! exists new
! exists docker.log

# The client secret must be long enough for PSAMA's HMAC key.
stdin short.txt
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auth0-client-secret-stdin
stderr '--auth0-client-secret-stdin: the client secret is 5 bytes; PSAMA needs at least 32'

# --self-update re-runs init, which can't read stdin again.
stdin one-line.txt
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auth0-client-secret-stdin --self-update
stderr 'run pic-sure self-update first'

# Stdin holds one secret, read with the shared reader: one trailing newline
# is stripped, any other line break is exit 2.
stdin two-lines.txt
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth0-client-id abc --auth0-client-secret-stdin
stderr '--auth0-client-secret-stdin'

# With both secret flags, stdin holds one secret per line.
stdin one-line.txt
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth0-client-id abc --db-mode remote --db-host db.example.com --auth0-client-secret-stdin --db-root-password-stdin
stderr '--auth0-client-secret-stdin and --db-root-password-stdin both read stdin: give one secret per line, in that order'
stdin blank-second.txt
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth0-client-id abc --db-mode remote --db-host db.example.com --auth0-client-secret-stdin --db-root-password-stdin
stderr '--db-root-password-stdin'

# DIR and a different --stack is a usage error; so are two DIRs.
exitcode 2 pic-sure --stack other init new
stderr 'name different directories'
exitcode 2 pic-sure init one two

# A host that isn't ready is exit 3, and nothing is written.
cp info-old-compose.json info.json
exitcode 3 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auto-ports
stderr 'the host isn''t ready'
stderr 'compose-version: docker compose v2.20.3 is older than 2.29.0'
! exists new
cp info-ok.json info.json

# A stack name another compose project uses is exit 3.
cp ps-other.json ps.json
exitcode 3 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auto-ports
stderr 'the stack name demo is in use by another stack or compose project \(container demo-web-1\)'
! exists new
cp empty.json ps.json

# A failed release fetch also leaves nothing behind.
exitcode 1 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auto-ports
stderr 'step release failed'
! exists new

# Explicit ports inside the default dev block pass validation: the block
# moves. The run fails later, at the release, or at the ports if the host
# uses them.
! exec pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --http-port 15000 --https-port 15001
stderr 'step release failed|is in use'
! exists new

# A port given that is the other's default is fine with --auto-ports, and a
# usage error without it.
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --http-port 443
stderr 'port 443 is the other port''s default'
! exec pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --http-port 443 --auto-ports
stderr 'step release failed|is in use'

# On a stack init finished, it does nothing and exits 0.
exec pic-sure init done
stdout 'Stack demo in .*done is already initialised; use `pic-sure up` or `pic-sure update`.'
exec pic-sure --json init done
stdout '"already_initialized":true'
stdout '"url":"https://localhost:8443/"'

# --set sets any non-secret key, as config set does, before the
# preconditions: the memory check reads the heap it sets.
! exec pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auto-ports --set hpds.java_opts=-Xmx32g
stderr 'this stack 32.0 GiB when up'
! exec pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auto-ports --set hpds.java_opts=-Xmx2g
! stderr 'when up'
stderr 'step release failed'
! exists new
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --set hpds.heap=2g
stderr '^pic-sure: --set hpds.heap=2g: hpds.heap: unknown config key$'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --set hpds.java_opts
stderr '--set hpds.java_opts: want KEY=VALUE'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --set network.http_port=eighty
stderr '--set network.http_port=eighty'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --set auth.auth0.client_secret=x
stderr '--set auth.auth0.client_secret: auth.auth0.client_secret is a secret; give it on stdin with --auth0-client-secret-stdin'
! stderr '=x'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --set email.password=x
stderr 'email.password is a secret'
exitcode 2 pic-sure init new --admin-email admin@example.com --auth-mode open --set name=demo
stderr '--set name=demo: use --name'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --set auth.mode=bogus
stderr '--set auth.mode=bogus: must be one of'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --set 'network.http_port= 0'
stderr '--set network.http_port=0: not a port number'
! exec pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auto-ports --hpds-data local --set hpds.shared_name=x
! stderr 'different values'

# A flag and a --set for the same key must agree, as must two --sets.
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --http-port 8081 --set network.http_port=8082
stderr '--set network.http_port=8082 and --http-port set network.http_port to different values'
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --set hpds.java_opts=-Xmx2g --set hpds.java_opts=-Xmx4g
stderr 'and --set hpds.java_opts=-Xmx2g set hpds.java_opts to different values'
! exec pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --auto-ports --set auth.admin_email=admin@example.com
stderr 'step release failed'

# The debug log of the flags redacts an admin email given with --set too.
exitcode 2 pic-sure --log-level debug init new --name demo --auth-mode open --set auth.admin_email=admin@example.com --skip-step bogus
stderr 'flags=.*--set=\[auth.admin_email=\[REDACTED\]\]'
! stderr 'admin@example.com'
exitcode 2 pic-sure --log-level debug init new --name demo --auth-mode open --set auth.auth0.client_secret=synthetic-secret-value
! stderr 'synthetic-secret-value'

# A --set port is used as the port flag would be.
exitcode 2 pic-sure init new --name demo --admin-email admin@example.com --auth-mode open --set network.http_port=443
stderr 'port 443 is the other port''s default'

# A resumed init refuses a --set that would change its pic-sure.yaml, and
# takes one that wouldn't.
exitcode 2 pic-sure init resume --set hpds.java_opts=-Xmx2g
stderr '--set hpds.java_opts=-Xmx2g: .*resume.pic-sure.yaml already has hpds.java_opts -Xmx4g, and init resumes with it as it is'
! exists resume/.pic-sure
! exec pic-sure init resume --set hpds.java_opts=-Xmx4g --set network.http_port=8083
! stderr 'already has'
stderr 'step release failed|is in use'
exitcode 2 pic-sure init resume --set hpds.java_opts=-Xmx2g --set hpds.java_opts=-Xmx4g
stderr 'already has hpds.java_opts -Xmx4g'
exitcode 2 pic-sure init resume --set name=other
stderr '--set name=other: name: is read-only'

-- short.txt --
short
-- one-line.txt --
synthetic-client-secret-0123456789abcdef
-- blank-second.txt --
synthetic-client-secret-0123456789abcdef

-- two-lines.txt --
first
second
-- docker.scenario --
docker info --format json => 0 stdout=info.json
docker version --format json => 0 stdout=version.json
docker image inspect alpine:* => 0 stdout=image.json
docker run * df -Pk / => 0 stdout=df.txt
docker rm -v -f pic-sure-doctor-* => 0
docker ps --all --no-trunc --filter * => 0 stdout=ps.json
docker ps * => 0
docker volume ls * => 0
docker image inspect * => 1
