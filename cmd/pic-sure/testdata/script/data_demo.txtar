# data demo's refusals, before it downloads or changes anything. The load
# itself is covered by the ops tests and the real runs.
env XDG_CACHE_HOME=$WORK/cache

# An unknown dataset, or more than one, is a usage error.
exitcode 2 pic-sure data demo frobnicate
stderr 'invalid argument "frobnicate"'
exitcode 2 pic-sure data demo nhanes synthea

# The heap is a positive number of MB.
exitcode 2 pic-sure --stack stack data demo --heap 0
stderr '--heap must be a positive number of MB, not 0'

# The steps can't be skipped.
exitcode 2 pic-sure --stack stack data demo --skip-step weights
stderr 'data demo has no steps to skip'

# No stack: exit 3.
exitcode 3 pic-sure data demo
stderr 'no pic-sure stack found'

# A stack using shared HPDS data is read-only: exit 1.
exitcode 1 pic-sure --stack shared data demo all
stderr 'uses the shared data set "demo-set" \(hpds.data: shared\), which is read-only'

# A stack init hasn't finished is exit 3.
exitcode 3 pic-sure --stack partial data demo
stderr 'isn''t initialised; run `pic-sure init .*partial` to finish it'

# An unrendered stack is exit 3.
exitcode 3 pic-sure --stack stack data demo synthea
stderr 'run `pic-sure up`'
! exists docker.log
! exists cache/pic-sure/downloads/946305e3138255dc-NHANES_abbreviated_allConcepts.csv.tgz

# data without a subcommand is a usage error.
exitcode 2 pic-sure data
stderr '^pic-sure: pic-sure data needs a subcommand$'

-- stack/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- stack/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
-- stack/.pic-sure/secrets.yaml --
db_root_password: rootpw
auth0_client_secret: generated-0123456789abcdef0123456789abcdef
auth0_client_secret_generated: true
-- partial/pic-sure.yaml --
schema: 1
name: partial
auth: {mode: open, admin_email: admin@example.com}
-- partial/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- shared/pic-sure.yaml --
schema: 1
name: shared
auth: {mode: open, admin_email: admin@example.com}
hpds: {data: shared, shared_name: demo-set}
-- shared/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
