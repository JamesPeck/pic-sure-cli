-- a/.pic-sure/manifest.json --
{"version": 1, "entries": [
  {"path": ".", "type": "dir"},
  {"path": ".pic-sure", "type": "dir"},
  {"path": ".pic-sure/manifest.json", "type": "file"},
  {"path": "pic-sure.yaml", "type": "file"},
  {"path": ".pic-sure/state.json", "type": "file"},
  {"path": ".pic-sure/secrets.yaml", "type": "file"},
  {"path": ".pic-sure/hpds", "type": "dir"},
  {"path": ".pic-sure/hpds/encryption_key", "type": "file"},
  {"path": ".pic-sure/render", "type": "dir"},
  {"path": ".pic-sure/render/compose.yaml", "type": "file"}
]}
