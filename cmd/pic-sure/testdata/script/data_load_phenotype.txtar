# load-phenotype's refusals, before it changes anything. The load itself is
# covered by the ops tests and the real runs.
env XDG_CACHE_HOME=$WORK/cache

# --input-dir must be a directory holding a CSV and no SQL input.
exitcode 2 pic-sure data load-phenotype --input-dir ''
stderr '--input-dir needs a directory'
exitcode 2 pic-sure data load-phenotype --input-dir missing
stderr '--input-dir: .*missing'
exitcode 2 pic-sure data load-phenotype --input-dir pheno.csv
stderr '--input-dir: .*pheno.csv isn''t a directory'
mkdir empty
exitcode 2 pic-sure data load-phenotype --input-dir empty
stderr '--input-dir: .*empty holds no .csv file'
exitcode 2 pic-sure data load-phenotype --input-dir sqldir
stderr 'load.sql is an SQL input, which pic-sure doesn''t load'
exitcode 2 pic-sure data load-phenotype --input-dir indir --entry a.csv
stderr '--entry is for --file'

# Exactly one of --file and --input-dir is required.
exitcode 2 pic-sure data load-phenotype
stderr 'at least one of the flags in the group \[file input-dir\] is required'
exitcode 2 pic-sure data load-phenotype --file a.csv --input-dir d

# The heap is a positive number of MB.
exitcode 2 pic-sure --stack stack data load-phenotype --file pheno.csv --heap 0
stderr '--heap must be a positive number of MB, not 0'
exitcode 2 pic-sure --stack stack data load-phenotype --file pheno.csv --heap 4g
stderr 'invalid argument "4g" for "--heap"'

# The loader's steps can't be skipped.
exitcode 2 pic-sure --stack stack data load-phenotype --file pheno.csv --skip-step hpds-input
stderr 'data load-phenotype has no steps to skip'

# The dictionary flags are checked before the stack is looked at.
exitcode 2 pic-sure data load-phenotype --file pheno.csv --dictionary manual
stderr '--dictionary must be auto or custom, not "manual"'
exitcode 2 pic-sure data load-phenotype --file pheno.csv --dictionary custom --datasets datasets.csv
stderr '--dictionary custom requires --datasets and --concepts'
exitcode 2 pic-sure data load-phenotype --file pheno.csv --datasets datasets.csv
stderr '--datasets is for --dictionary custom'
exitcode 2 pic-sure data load-phenotype --file pheno.csv --facets facets.csv
stderr '--facets is for --dictionary custom'
exitcode 2 pic-sure data load-phenotype --file pheno.csv --dictionary custom --datasets datasets.csv --concepts concepts.zip --facets facets.csv
stderr '--facets-categories, --facets and --facet-concepts go together: give all three or none'
exitcode 2 pic-sure data load-phenotype --file pheno.csv --dictionary custom --datasets missing.csv --concepts concepts.zip
stderr '--datasets: .*missing.csv'
exitcode 2 pic-sure data load-phenotype --file pheno.csv --dictionary custom --datasets datasets.csv --concepts concepts.zip --facets-categories cat.csv --facets facets.csv --facet-concepts missing.csv
stderr '--facet-concepts: .*missing.csv'
chmod 000 cat.csv
exitcode 2 pic-sure data load-phenotype --file pheno.csv --dictionary custom --datasets datasets.csv --concepts concepts.zip --facets-categories cat.csv --facets facets.csv --facet-concepts facets.csv
stderr '--facets-categories: .*permission denied'
chmod 644 cat.csv

# No stack: exit 3.
exitcode 3 pic-sure data load-phenotype --file pheno.csv
stderr 'no pic-sure stack found'
exitcode 3 pic-sure data load-phenotype --file pheno.csv --dictionary custom --datasets datasets.csv --concepts concepts.zip --facets-categories cat.csv --facets facets.csv --facet-concepts facets.csv --skip-weights
stderr 'no pic-sure stack found'

# A stack using shared HPDS data is read-only: exit 1.
exitcode 1 pic-sure --stack shared data load-phenotype --file pheno.csv
stderr 'uses the shared data set "demo-set" \(hpds.data: shared\), which is read-only'

# A stack init hasn't finished is exit 3.
exitcode 3 pic-sure --stack partial data load-phenotype --file pheno.csv
stderr 'isn''t initialised; run `pic-sure init .*partial` to finish it'

# An unrendered stack is exit 3.
exitcode 3 pic-sure --stack stack data load-phenotype --file pheno.csv
stderr 'run `pic-sure up`'

# An --input-dir is checked before the stack is looked at.
exitcode 3 pic-sure data load-phenotype --input-dir indir
stderr 'no pic-sure stack found'

# A missing file is exit 2.
mkdir stack/.pic-sure/render
cp compose.yaml stack/.pic-sure/render/compose.yaml
exitcode 2 pic-sure --stack stack data load-phenotype --file missing.csv
stderr 'missing.csv'
! exists docker.log

-- pheno.csv --
PATIENT_NUM,CONCEPT_PATH,NUMERIC_VALUE,TEXT_VALUE
1,\demo\age\,42,
-- indir/a.csv --
PATIENT_NUM,CONCEPT_PATH,NUMERIC_VALUE,TEXT_VALUE
1,\demo\age\,42,
-- sqldir/a.csv --
PATIENT_NUM,CONCEPT_PATH,NUMERIC_VALUE,TEXT_VALUE
-- sqldir/load.sql --
select 1
-- datasets.csv --
ref,full_name,abbreviation,description
-- concepts.zip --
not checked before the stack
-- cat.csv --
name(unique)
-- facets.csv --
facet_name(unique)
-- compose.yaml --
name: demo
-- stack/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- stack/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
-- stack/.pic-sure/secrets.yaml --
db_root_password: rootpw
auth0_client_secret: generated-0123456789abcdef0123456789abcdef
auth0_client_secret_generated: true
-- partial/pic-sure.yaml --
schema: 1
name: partial
auth: {mode: open, admin_email: admin@example.com}
-- partial/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- shared/pic-sure.yaml --
schema: 1
name: shared
auth: {mode: open, admin_email: admin@example.com}
hpds: {data: shared, shared_name: demo-set}
-- shared/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1, "initialized_at": "2026-10-07T12:00:00Z"}
