# Preview has one visible spelling, including completion.
exec pic-sure migrate --help
stdout '--dry-run'
! stdout '--check'
exec pic-sure __complete migrate --
stdout '--dry-run'
! stdout '--check'

# Both spellings name the same flag, even with explicit false values.
exitcode 2 pic-sure migrate --dry-run --check
stderr 'same flag'
exitcode 2 pic-sure migrate --check=false --dry-run=false
stderr 'same flag'
exitcode 2 pic-sure migrate --dry-run --repair
stderr 'none of the others can be'
exitcode 2 pic-sure migrate --dry-run --skip-step db
stderr '--dry-run.*runs no steps'
exitcode 2 pic-sure migrate --check --skip-step db
stderr '--dry-run.*runs no steps'

# --check and --repair are mutually exclusive.
exitcode 2 pic-sure migrate --check --repair

# No stack: exit 3.
exitcode 3 pic-sure migrate
stderr 'no pic-sure stack found'

# A stack that was never rendered: exit 3, pointing at up.
exitcode 3 pic-sure --stack unrendered migrate
stderr 'has not been rendered.*run `pic-sure up`'
exitcode 3 pic-sure --stack unrendered migrate --check

# A stack without secrets.yaml hasn't finished init.
exitcode 3 pic-sure --stack nosecrets migrate
stderr 'no secrets.yaml; run `pic-sure init`'

# --check prints one report and exits 3 when an input is missing. The
# runner can't reach docker here, so compose config fails too.
exitcode 3 pic-sure --stack stack --json migrate --check
stdout '^\{"schema_version":2,"ok":false,"inputs":\[\{"name":"compose config","ok":false,"problem":"[^"]+"\},'
stdout '"name":"project UUIDs","ok":false,"problem":"secrets.yaml lacks application_uuid, resource_uuid, visualization_uuid"'
! stdout '"type"'
cp stdout check.json
cp stderr check.stderr
! stderr deprecat
exitcode 3 pic-sure --stack stack --json migrate --dry-run
cmp stdout check.json
cmp stderr check.stderr
! stderr deprecat
! exists stack/.pic-sure/lock
exitcode 3 pic-sure --stack stack --plain migrate --check
stdout '^FAIL compose config'
stdout '^FAIL project UUIDs \(secrets.yaml lacks application_uuid, resource_uuid, visualization_uuid\)$'
! stdout 'look valid'

# A migrate that can't start the database fails in the db step. Docker
# answers only the ownership check.
cp owned.scenario docker.scenario
exitcode 1 pic-sure --stack stack --json migrate
stdout '"type":"step_done","id":"db","status":"failed"'
stdout '"step":"db"'

# --skip-step takes the migrate command's step IDs only.
exitcode 2 pic-sure --stack stack migrate --skip-step seed
stderr 'db, migrate'

-- stack/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- stack/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- stack/.pic-sure/secrets.yaml --
db_root_password: synthetic-root-password
-- stack/.pic-sure/render/compose.yaml --
services: {}
-- unrendered/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- unrendered/.pic-sure/secrets.yaml --
db_root_password: synthetic-root-password
-- nosecrets/pic-sure.yaml --
schema: 1
name: demo
auth: {mode: open, admin_email: admin@example.com}
-- nosecrets/.pic-sure/render/compose.yaml --
services: {}
-- owned.scenario --
docker ps --all --no-trunc --filter label=com.docker.compose.project=* --format * => 0
docker volume ls -q --filter label=com.docker.compose.project=* => 0
docker volume ls -q --filter label=org.hms-dbmi.picsure.stack=* => 0
docker network ls -q --no-trunc --filter label=com.docker.compose.project=* => 0
