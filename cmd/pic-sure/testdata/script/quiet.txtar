name: nolog
auth: {mode: open, admin_email: admin@example.com}
-- nolog/.pic-sure/state.json --
{"cli_version": "dev", "schema_version": 1}
-- nolog/.pic-sure/secrets.yaml --
db_root_password: rootpw
-- nolog/.pic-sure/render/compose.yaml --
name: nolog
services: {}
-- nolog/.pic-sure/logs --
not a directory, so the run log can't be written
