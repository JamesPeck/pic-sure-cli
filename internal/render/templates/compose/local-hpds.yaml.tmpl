# HPDS data in this stack's own volumes, for hpds.data: local.
# shared-hpds restates hpds's volume list; keep the two in step.

services:
  hpds:
    volumes:
      - hpds-data:/opt/local/hpds
      - hpds-genomic:/opt/local/hpds/all
      - hpds-csv:/usr/local/docker-config/hpds_csv
      - hpds-query-results:/gic_query_results
      - hpds-logs:/var/log

volumes:
  # The phenotype store and its encryption key.
  hpds-data:
    labels: {{ flow (.VolumeLabels "hpds-data") }}
  hpds-genomic:
    labels: {{ flow (.VolumeLabels "hpds-genomic") }}
