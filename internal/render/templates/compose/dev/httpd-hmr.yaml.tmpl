# dev on httpd-hmr: replaces httpd with a Vite dev server running the local
# frontend checkout, so edits show up without a rebuild. Browse to
# http://localhost:<port>, not the stack's https URL. Vite proxies /picsure/*
# to the gateway (prefix stripped) and /psama/* to psama (rewritten to /auth).

services:
  # HTTPD, replaced by the Vite dev server of dev on httpd-hmr.
  httpd:
    image: {{ q (.Image "node") }}
{{- with .HostUser }}
    # The operator's UID:GID, so what Vite writes into the checkout
    # (.svelte-kit/, config timestamps) is theirs. pic-sure gives the
    # node_modules volume to the same user before starting it.
    user: {{ q . }}
{{- end }}
    working_dir: /app
    # pnpm goes under /tmp because that user can't write the image's global
    # prefix, and its store into the node_modules volume, which keeps it
    # across recreates on the same file system as the packages. The Vite
    # config is copied into node_modules too: Vite writes its bundled config
    # beside it, it resolves vite from there, and the checkout stays clean.
    # (Bind-mounting it into /app would need a mount point in the checkout,
    # which runc refuses to create through a bind mount.)
    command:
      - sh
      - -c
      - >-
        npm install -g --prefix /tmp/npm-global pnpm@10.24.0 &&
        /tmp/npm-global/bin/pnpm install --store-dir /app/node_modules/.pnpm-store --config.confirmModulesPurge=false &&
        mkdir -p node_modules/.pic-sure &&
        cp /opt/pic-sure/vite.config.dev.ts node_modules/.pic-sure/vite.config.aio.ts &&
        exec /tmp/npm-global/bin/pnpm dev --config node_modules/.pic-sure/vite.config.aio.ts
    volumes:
      - type: bind
        source: {{ q .FrontendSrc }}
        target: /app
        bind: {create_host_path: false}
      - frontend-node-modules:/app/node_modules
      - type: bind
        source: {{ q (path .FilesDir "httpd/vite.config.dev.ts") }}
        target: /opt/pic-sure/vite.config.dev.ts
        bind: {create_host_path: false}
        read_only: true
    ports:
      - "127.0.0.1:{{ .DevPort "httpd-hmr" }}:3000"
    environment:
      NODE_ENV: development
      # The host user has no home directory in the image.
      HOME: /tmp
{{- range $name, $value := .FrontendEnv }}
      {{ q $name }}: {{ q $value }}
{{- end }}
{{- if .Proxy }}
      # npm and pnpm fetch packages.
      HTTP_PROXY: ${HTTP_PROXY}
      HTTPS_PROXY: ${HTTPS_PROXY}
      NO_PROXY: ${NO_PROXY}
      http_proxy: ${HTTP_PROXY}
      https_proxy: ${HTTPS_PROXY}
      no_proxy: ${NO_PROXY}
{{- end }}
    # The Vite server's own page, on IPv4: Vite listens on 0.0.0.0, and
    # localhost is ::1 first. A first install and the first server-side
    # render can be slow.
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:3000/"]
      interval: 10s
      timeout: 30s
      retries: 3
      start_period: 5m

volumes:
  frontend-node-modules:
    labels: {{ flow .Labels }}
