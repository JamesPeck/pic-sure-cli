# dev on query: pic-sure-hpds-query-service from the local pic-sure checkout, with a
# JDWP debug port on 127.0.0.1. Render adds the JDWP agent (address *:5005) to
# its JAVA_OPTS.

services:
  pic-sure-hpds-query-service:
    image: {{ q (.DevImage "pic-sure-hpds-query-service") }}
    ports:
      - "127.0.0.1:{{ .DevPort "query" }}:5005"
